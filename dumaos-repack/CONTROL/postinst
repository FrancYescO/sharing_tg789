#!/bin/sh

. "$IPKG_INSTROOT/lib/functions.sh"

# The only unavoidable firmware-wide compatibility change is the ubus ABI.
# Activate it transactionally before touching UCI or starting services.
if [ -z "$IPKG_INSTROOT" ]; then
  chmod 755 /usr/lib/dumaos/platform/ubus-stack.sh
  if ! /usr/lib/dumaos/platform/ubus-stack.sh activate; then
    echo "dumaos-repack: ubus activation failed; stock stack restored" >&2
    exit 1
  fi

  # Finish migration from releases that owned global compatibility tools.
  migration=/etc/dumaos-stock-backup/tools
  [ ! -s "$migration/openssl" ] || { cp -f "$migration/openssl" /usr/bin/openssl && chmod 755 /usr/bin/openssl; }
  [ ! -s "$migration/conntrack" ] || { cp -f "$migration/conntrack" /usr/sbin/conntrack && chmod 755 /usr/sbin/conntrack; }
  [ ! -s "$migration/wl" ] || { cp -f "$migration/wl" /usr/bin/wl && chmod 755 /usr/bin/wl; }
  [ -x /bin/busybox ] && ln -sf busybox /bin/tar
  if [ -e /usr/lib/libnetfilter_queue.so.1.5.0 ]; then
    rm -f /usr/lib/libnetfilter_queue.so.1
    ln -sf libnetfilter_queue.so.1.5.0 /usr/lib/libnetfilter_queue.so.1
  fi
  rm -f /usr/bin/wl.orig /usr/sbin/conntrack.orig /sbin/ubus.orig /usr/sbin/ndhttpd.real
  rm -rf /etc/dumaos-conntrack-stock /etc/dumaos/wl-agtef
  rm -rf "$migration"
  if [ -f /etc/ld.so.preload ]; then
    sed -i '/nfqverdict-shim/d;/openssl-compat-shim/d' /etc/ld.so.preload
  fi
fi

# Enable DumaOS (the Telstra-branded UI gates on dumaos.tr69.dumaos_enabled)
uci -q set dumaos.tr69=tr69
uci -q set dumaos.tr69.dumaos_enabled=1
uci -q commit dumaos

# "Default 3.0" theme (the Netduma-red palette shipped with DumaOS 3.3.535,
# xr500full theme + bg.svg) under /dumaos/themes/default30; select it on a
# fresh install (reset-initialise-themes.lua is patched to keep it across
# boots instead of resetting to stock default).
if [ -z "$IPKG_INSTROOT" ]; then
  t=$(uci -q get dumaos.dumaos_nvram.DumaOS_Theme 2>/dev/null)
  case "$t" in
    ""|default)
      uci -q set dumaos.dumaos_nvram.DumaOS_Theme=default30
      uci -q set dumaos.dumaos_nvram.DumaOS_Theme_Version='1.0'
      uci -q commit dumaos
      ;;
  esac
fi

# Per-app frontend translation catalogs: cli.lua asserts
# <app>/frontend/shared/i18n.json exists for every app served over RPC.
# English strings live in /www/language/dumaoslang-*.json (prepared at
# first start by procmanager), so an empty catalog is enough.
if [ -z "$IPKG_INSTROOT" ]; then
  for app in /dumaos/apps/system/* /dumaos/apps/usr/*; do
    [ -d "$app" ] || continue
    [ -f "$app/frontend/shared/i18n.json" ] || { mkdir -p "$app/frontend/shared"; echo '{}' > "$app/frontend/shared/i18n.json"; }
  done
fi

# Restore exec bits on every installed binary/script: git and tar can
# lose them (644 ELF = "Permission denied", e.g. /sbin/ubus.orig), so
# normalise from the opkg file list after every install/upgrade.
[ -n "$IPKG_INSTROOT" ] || \
while read -r f; do
  [ -n "$f" ] && [ -f "$f" ] && [ ! -x "$f" ] || continue
  case "$f" in *.so|*.so.*|*.lua|*.conf|*.json|*.html|*.js|*.css|*.txt) continue;; esac
  m=$(head -c 4 "$f" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')
  case "$m" in 7f454c46|"2321"*) chmod +x "$f";; esac
done < /usr/lib/opkg/info/dumaos-repack.list

# The desktop UI fetches /themes/<name>/ from the ndhttpd docroot (/www),
# which has no themes dir; /themes/ and /nd-themes/ are special-cased by
# ndhttpd and it serves directories through an "ndindex.html" index page.
# Link the theme trees into the docroot and give the default theme its
# index (duma-theme.html is the index content, ndhttpd renders it).
if [ -z "$IPKG_INSTROOT" ]; then
  ln -sfn /dumaos/themes /www/themes
  ln -sfn /dumaos/themes/cloud /www/nd-themes
  rm -rf /www/themes/default/default
  [ -f /dumaos/themes/default/ndindex.html ] || cp /dumaos/themes/default/duma-theme.html /dumaos/themes/default/ndindex.html
fi

# The package installs /etc/nginx/main_dumaos.conf, which Telstra ships
# disabled in dumaos-available/ but nginx.conf includes as main_*.conf.
# It reverse-proxies the DumaOS UI on :80/:443 (/desktop, /ndindex.html,
# /nd-css, /nd-js, /json, /duma-socket/<port> -> 127.0.0.1), so the UI
# works like on the official modem instead of hitting :81 directly. The
# shipped copy keeps the official tch_auth session gate (so the portal
# login protects the UI) but makes it work on AGTEF: the if/set proxy-port
# rewrite is replaced by one location per app websocket port (this nginx
# is built --without-http_rewrite_module and --without-pcre), the CSRF
# body filter is nil-safe, and tch_auth is kept only on the exact locations
# because web.sessioncontrol authorises by EXACT uri in ruleset_main.
# Register the DumaOS uris in the portal ruleset so a logged-in admin
# (or engineer) passes tch_auth, like the Telstra portal pages do.
if [ -z "$IPKG_INSTROOT" ] && command -v uci >/dev/null 2>&1; then
  for pair in desktop_index:/desktop/index.html relay:/desktop/relay.html webview:/desktop/webview.html ndindex:/ndindex.html bower:/bower.json; do
    n=${pair%%:*}; t=${pair#*:}
    uci -q get "web.duma_$n" >/dev/null 2>&1 || {
      uci -q set "web.duma_$n=rule"
      uci -q set "web.duma_$n.target=$t"
      uci -q add_list "web.duma_$n.roles=admin"
      uci -q add_list "web.duma_$n.roles=engineer"
    }
    uci -q get web.ruleset_main.rules | grep -qw "duma_$n" || \
      uci -q add_list "web.ruleset_main.rules=duma_$n"
  done
  for p in 8090 8091 8092 8093 8094 9090 9091 9092 9093 9094; do
    uci -q get web.duma_ws_$p >/dev/null 2>&1 || {
      uci -q set web.duma_ws_$p=rule
      uci -q set web.duma_ws_$p.target=/duma-socket/$p
      uci -q add_list web.duma_ws_$p.roles=admin
      uci -q add_list web.duma_ws_$p.roles=engineer
    }
    uci -q get web.ruleset_main.rules | grep -qw duma_ws_$p || \
      uci -q add_list web.ruleset_main.rules=duma_ws_$p
  done
  uci -q del_list web.ruleset_main.rules=dumaosmodal
  uci -q add_list web.ruleset_main.rules=dumaosmodal
  uci -q set web.dumaosmodal=rule
  uci -q set web.dumaosmodal.target=/modals/dumaos-modal.lp
  uci -q delete web.dumaosmodal.roles
  uci -q add_list web.dumaosmodal.roles=admin
  uci -q add_list web.dumaosmodal.roles=engineer
  uci -q add_list web.dumaosmodal.roles=superuser
  uci -q set web.dumaos_card=card
  uci -q set web.dumaos_card.card=015_dumaos.lp
  uci -q set web.dumaos_card.modal=dumaosmodal
  uci -q commit web
fi

# DumaOS apps run under glibc, which only honours TZ (never set by init)
# or /etc/localtime; without either every server-side timestamp (speedtest
# history, app logs) is UTC instead of the modem timezone. Point
# /etc/localtime at the zone configured in uci (glibc ignores POSIX TZ
# strings like the one in system.@system[0].timezone, so use zonename).
if [ -z "$IPKG_INSTROOT" ] && ! [ -e /etc/localtime ]; then
  ZONE=$(uci -q get system.@system[0].zonename 2>/dev/null)
  [ -f "/usr/share/zoneinfo/$ZONE" ] || ZONE="Europe/Rome"
  ln -sf "/usr/share/zoneinfo/$ZONE" /etc/localtime
fi

# The DumaOS timezone dropdown (config app -> time_zone.lua) reads
# system.@system[0].network_timezone as an id into its own table; the
# stock default 0 is not a valid id there, so the UI falls back to
# "(GMT+10:00) Brisbane". 22 = Amsterdam, Berlin, Bern, Rome, ...
if [ -z "$IPKG_INSTROOT" ]; then
  ntz=$(uci -q get system.@system[0].network_timezone 2>/dev/null)
  if [ -z "$ntz" ] || [ "$ntz" = "0" ]; then
    uci -q set system.@system[0].network_timezone='22'
    uci -q commit system
  fi
  tzv=$(uci -q get system.@system[0].timezone 2>/dev/null)
  case "$tzv" in
    ""|UTC|GMT)
      uci -q set system.@system[0].timezone='CET-1CEST,M3.5.0,M10.5.0/3'
      uci -q set system.@system[0].zonename='Europe/Rome'
      uci -q commit system
      ;;
  esac
fi

# The shipped init scripts now provide TZ, the private PATH and the private
# library path directly; no generated wrapper or in-place init mutation is
# required.

# The benchmark app never parses test results into the history index when
# options.save is true (that branch runs upload_test_data against the dead
# netduma cloud, which also deletes the history files), so the UI history
# stays empty and the detail page ("get_file_data") finds nothing because
# it only reads <time>.txt.gz. Two cron jobs cover both: one fills
# index.tests[].data from the raw 0-x/1-x/2-x result lines, the other
# gzips finished test files (the app gunzips/re-gzips them on read).
if [ -z "$IPKG_INSTROOT" ]; then
  chmod +x /usr/sbin/bench-gzip.sh /usr/sbin/bench-index.lua 2>/dev/null
  grep -q bench-index.lua /etc/crontabs/root 2>/dev/null || \
    sed -i '1i */2 * * * * lua /usr/sbin/bench-index.lua' /etc/crontabs/root 2>/dev/null
  grep -q bench-gzip.sh /etc/crontabs/root 2>/dev/null || \
    sed -i '1i */2 * * * * /bin/sh /usr/sbin/bench-gzip.sh' /etc/crontabs/root 2>/dev/null
fi

# DPI database ships in this package; restart the classifier so it loads the new nddpidb
if [ -z "$IPKG_INSTROOT" ]; then
  killall dpiclass 2>/dev/null
fi

# devicemanager/filesync.lua shadows the framework lib inside the app
# directory (exec.lua's app-dir loader runs it in the app env, where rpc is
# the RPC dispatcher table) and registers get_catmark/get_appmark/
# get_devlist/update_device_name_and_type, which dpi.lua/devices.lua only
# define as on_* globals, so the Network Monitor RPCs stop answering
# "Nonexistant remote procedure". Restart devicemanager so procmanager
# respawns it with the shadow loaded.
if [ -z "$IPKG_INSTROOT" ]; then
  for p in $(ps w | grep 'cli.lua -p //dumaos/apps/system//com.netdumasoftware.devicemanager' | grep -v grep | awk '{print $1}'); do kill "$p" 2>/dev/null; done
fi

# ctwatch Lua shim: the stock ctwatch binary never reads connmarks on the
# AGTEF kernel (cmark stays 0, so the Network Monitor shows only
# "Uncategorized"). The shim owns com.netdumasoftware.ctwatch on ubus,
# answers gettable/get_local_networks/rpc(filter_connections,get_cmark_mask)
# from /proc/net/nf_conntrack and promotes DNS-derived DPI pappids to real
# appids (bits 14-22) with conntrack -U, which is what the UI decodes with
# the get_cmark_mask [shift,mask] pair. The stock binary claims the same
# ubus name, so keep it disabled; dumaos init starts the shim instead.
if [ -z "$IPKG_INSTROOT" ]; then
  chmod +x /etc/init.d/ctwatch-shim /dumaos/ctwatch-shim.lua \
    /usr/lib/dumaos/platform/control.sh 2>/dev/null
  mkdir -p /www/data
  [ ! -s /dumaossystem/version ] || cp /dumaossystem/version /www/data/shorthash
  chmod 644 /www/data/shorthash 2>/dev/null
  /etc/init.d/ctwatch stop 2>/dev/null
  /etc/init.d/ctwatch disable 2>/dev/null
  /etc/init.d/ctwatch-shim enable 2>/dev/null
  killall ctwatch 2>/dev/null
fi

if [ -z "$IPKG_INSTROOT" ] && command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
  nginx -s reload 2>/dev/null || /etc/init.d/nginx restart >/dev/null 2>&1
fi

# Drop the stock telemetry R-App (phoning home to netduma; the DumaCloud
# it belongs to is dead). procmanager just stops spawning it once the app
# dir is gone; also clean up the /modoverlay/repack-backups copy left by
# older repack versions that only moved it aside.
if [ -z "$IPKG_INSTROOT" ]; then
  if [ -d /dumaos/apps/usr/com.netdumasoftware.telemetry ]; then
    for p in $(ps w | grep 'cli.lua -p //dumaos/apps/usr//com.netdumasoftware.telemetry' | grep -v grep | awk '{print $1}'); do kill "$p" 2>/dev/null; done
    rm -rf /dumaos/apps/usr/com.netdumasoftware.telemetry
  fi
  rm -rf /modoverlay/repack-backups/com.netdumasoftware.telemetry
fi

if [ -z "$IPKG_INSTROOT" ]; then
  /etc/init.d/ndhttpd enable
  /etc/init.d/dumaos enable
  /etc/init.d/ndhttpd restart || {
    /usr/lib/dumaos/platform/ubus-stack.sh restore keep || true
    exit 1
  }
  /etc/init.d/dumaos restart || {
    /etc/init.d/ndhttpd stop 2>/dev/null
    /usr/lib/dumaos/platform/ubus-stack.sh restore keep || true
    exit 1
  }
fi

exit 0
