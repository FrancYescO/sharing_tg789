#!/bin/sh

. $IPKG_INSTROOT/lib/functions.sh

# Enable DumaOS (the Telstra-branded UI gates on dumaos.tr69.dumaos_enabled)
uci -q set dumaos.tr69=tr69
uci -q set dumaos.tr69.dumaos_enabled=1
uci -q commit dumaos

# Per-app frontend translation catalogs: cli.lua asserts
# <app>/frontend/shared/i18n.json exists for every app served over RPC.
# English strings live in /www/language/dumaoslang-*.json (prepared at
# first start by procmanager), so an empty catalog is enough.
if [ -z "$IPKG_INSTROOT" ]; then
  for app in /dumaos/apps/system/* /dumaos/apps/usr/*; do
    [ -d "$app" ] || continue
    [ -f "$app/frontend/shared/i18n.json" ] || { mkdir -p "$app/frontend/shared"; echo '{}' > "$app/frontend/shared/i18n.json"; }
  done
fi

# The stock Broadcom 4.1.52 kernel rejects the verdict-extra netlink
# attribute used by DumaOS's custom libnetfilter_queue, so every nfqueue
# verdict (dpiclass QoS, geoip) is refused and DNS stalls in queue 10.
# The preload shim translates nfq_set_verdict2_extra() to plain
# nfq_set_verdict2(). The Telstra libssl/libcrypto lack the zlib/SRP/NPN
# symbols the stock openssl binary references, so every openssl call
# died with "undefined symbol: BIO_f_zlib" (exit 127), breaking DumaOS
# cloud package verify/decrypt; /usr/bin/openssl is replaced by a static
# 1.1.1w build (cloud .cloud files need the SHA-256 EVP KDF of 1.1.x) and
# openssl-compat-shim.so covers any other dynamically linked consumer.
# ld.so.preload is shared with Telstra's libpreload-tch.so, so append
# (and never overwrite).
if [ -z "$IPKG_INSTROOT" ]; then
  grep -q '^/usr/lib/nfqverdict-shim.so$' /etc/ld.so.preload 2>/dev/null || \
    echo /usr/lib/nfqverdict-shim.so >> /etc/ld.so.preload
  if [ -f /usr/lib/openssl-compat-shim.so ]; then
    grep -q '^/usr/lib/openssl-compat-shim.so$' /etc/ld.so.preload 2>/dev/null || \
      echo /usr/lib/openssl-compat-shim.so >> /etc/ld.so.preload
  fi
fi

# Stash the stock AGTEF ubus stack outside the package filelist so postrm
# can restore it after opkg has purged the package's own files.
if [ -z "$IPKG_INSTROOT" ] && [ -d /etc/dumaos/ubus-agtef ] && ! [ -e /etc/dumaos-ubus-stock/ubusd ]; then
  mkdir -p /etc/dumaos-ubus-stock
  cp -f /etc/dumaos/ubus-agtef/* /etc/dumaos-ubus-stock/
fi

# /sbin/ubus becomes a wrapper answering the phantom Netduma
# mapVendorExtensions.* ubus calls (devicemanager spams "Command failed:
# Not found" + a JSON decode error every minute without them); keep the
# stock binary reachable at /sbin/ubus.orig for it to exec.
if [ -z "$IPKG_INSTROOT" ] && ! [ -e /sbin/ubus.orig ]; then
  if [ -f /etc/dumaos/ubus-agtef/ubus ]; then
    cp -f /etc/dumaos/ubus-agtef/ubus /sbin/ubus.orig
  elif [ -f /sbin/ubus-agtef/ubus ]; then
    cp -f /sbin/ubus-agtef/ubus /sbin/ubus.orig
  fi
fi

# /usr/bin/wl becomes a wrapper that silences "wl -i <iface>" calls for
# interfaces that do not exist (AGTEF exposes only wl0, while DumaOS
# devicemanager polls wl1 for 5GHz stats every minute); the stock binary
# ships as /usr/bin/wl-agtef/wl and is kept at /usr/bin/wl.orig.
if [ -z "$IPKG_INSTROOT" ] && ! [ -e /usr/bin/wl.orig ] && [ -f /usr/bin/wl-agtef/wl ]; then
  mkdir -p /etc/dumaos/wl-agtef
  cp -f /usr/bin/wl-agtef/wl /etc/dumaos/wl-agtef/wl
  cp -f /usr/bin/wl-agtef/wl /usr/bin/wl.orig
fi

# The stock AGTEF conntrack (v1.4.5) has no "-k" mark filter, which the
# Geo-Filter uses to flush denied conntracks; the package ships a wrapper
# at /usr/sbin/conntrack that rewrites -k to -m and execs conntrack.orig.
# Stash the stock binary outside the package filelist so postrm can
# restore it after opkg purges our files.
if [ -z "$IPKG_INSTROOT" ] && [ -f /etc/dumaos/conntrack-agtef/conntrack ] && ! [ -e /etc/dumaos-conntrack-stock/conntrack ]; then
  mkdir -p /etc/dumaos-conntrack-stock
  cp -f /etc/dumaos/conntrack-agtef/conntrack /etc/dumaos-conntrack-stock/
fi

# The desktop UI fetches /themes/<name>/ from the ndhttpd docroot (/www),
# which has no themes dir; /themes/ and /nd-themes/ are special-cased by
# ndhttpd and it serves directories through an "ndindex.html" index page.
# Link the theme trees into the docroot and give the default theme its
# index (duma-theme.html is the index content, ndhttpd renders it).
if [ -z "$IPKG_INSTROOT" ]; then
  ln -sfn /dumaos/themes /www/themes
  ln -sfn /dumaos/themes/cloud /www/nd-themes
  rm -rf /www/themes/default/default
  [ -f /dumaos/themes/default/ndindex.html ] || cp /dumaos/themes/default/duma-theme.html /dumaos/themes/default/ndindex.html
fi

# The package installs /etc/nginx/main_dumaos.conf, which Telstra ships
# disabled in dumaos-available/ but nginx.conf includes as main_*.conf.
# It reverse-proxies the DumaOS UI on :80/:443 (/desktop, /ndindex.html,
# /nd-css, /nd-js, /json, /duma-socket/<port> -> 127.0.0.1), so the UI
# works like on the official modem instead of hitting :81 directly. The
# shipped copy keeps the official tch_auth session gate (so the portal
# login protects the UI) but makes it work on AGTEF: the if/set proxy-port
# rewrite is replaced by one location per app websocket port (this nginx
# is built --without-http_rewrite_module and --without-pcre), the CSRF
# body filter is nil-safe, and tch_auth is kept only on the exact locations
# because web.sessioncontrol authorises by EXACT uri in ruleset_main.
# Register the DumaOS uris in the portal ruleset so a logged-in admin
# (or engineer) passes tch_auth, like the Telstra portal pages do.
if [ -z "$IPKG_INSTROOT" ] && command -v uci >/dev/null 2>&1; then
  for pair in desktop_index:/desktop/index.html relay:/desktop/relay.html webview:/desktop/webview.html ndindex:/ndindex.html bower:/bower.json; do
    n=${pair%%:*}; t=${pair#*:}
    uci -q get web.duma_$n >/dev/null 2>&1 || {
      uci -q set web.duma_$n=rule
      uci -q set web.duma_$n.target=$t
      uci -q add_list web.duma_$n.roles=admin
      uci -q add_list web.duma_$n.roles=engineer
    }
    uci -q get web.ruleset_main.rules | grep -qw duma_$n || \
      uci -q add_list web.ruleset_main.rules=duma_$n
  done
  for p in 8090 8091 8092 8093 8094 9090 9091 9092 9093 9094; do
    uci -q get web.duma_ws_$p >/dev/null 2>&1 || {
      uci -q set web.duma_ws_$p=rule
      uci -q set web.duma_ws_$p.target=/duma-socket/$p
      uci -q add_list web.duma_ws_$p.roles=admin
      uci -q add_list web.duma_ws_$p.roles=engineer
    }
    uci -q get web.ruleset_main.rules | grep -qw duma_ws_$p || \
      uci -q add_list web.ruleset_main.rules=duma_ws_$p
  done
  uci -q commit web
fi

# DumaOS apps run under glibc, which only honours TZ (never set by init)
# or /etc/localtime; without either every server-side timestamp (speedtest
# history, app logs) is UTC instead of the modem timezone. Point
# /etc/localtime at the zone configured in uci (glibc ignores POSIX TZ
# strings like the one in system.@system[0].timezone, so use zonename).
if [ -z "$IPKG_INSTROOT" ] && ! [ -e /etc/localtime ]; then
  ZONE=$(uci -q get system.@system[0].zonename 2>/dev/null)
  [ -f "/usr/share/zoneinfo/$ZONE" ] || ZONE="Europe/Rome"
  ln -sf "/usr/share/zoneinfo/$ZONE" /etc/localtime
fi

# The DumaOS timezone dropdown (config app -> time_zone.lua) reads
# system.@system[0].network_timezone as an id into its own table; the
# stock default 0 is not a valid id there, so the UI falls back to
# "(GMT+10:00) Brisbane". 22 = Amsterdam, Berlin, Bern, Rome, ...
if [ -z "$IPKG_INSTROOT" ]; then
  ntz=$(uci -q get system.@system[0].network_timezone 2>/dev/null)
  if [ -z "$ntz" ] || [ "$ntz" = "0" ]; then
    uci -q set system.@system[0].network_timezone='22'
    uci -q commit system
  fi
  tzv=$(uci -q get system.@system[0].timezone 2>/dev/null)
  case "$tzv" in
    ""|UTC|GMT)
      uci -q set system.@system[0].timezone='CET-1CEST,M3.5.0,M10.5.0/3'
      uci -q set system.@system[0].zonename='Europe/Rome'
      uci -q commit system
      ;;
  esac
fi

# The UI timezone (time_zone.lua getTimeZoneID) is actually os.getenv("TZ")
# of the app processes, which are spawned by ndhttpd; procd on this
# firmware ignores the "env" param, so wrap ndhttpd to export TZ from uci
# system.timezone (the string must match the lua table entry exactly).
if [ -z "$IPKG_INSTROOT" ]; then
  if [ ! -e /usr/sbin/ndhttpd.real ]; then
    mv /usr/sbin/ndhttpd /usr/sbin/ndhttpd.real
  fi
  cat > /usr/sbin/ndhttpd <<'NDEOF'
#!/bin/sh
[ -n "$TZ" ] || TZ="$(uci -q get system.@system[0].timezone 2>/dev/null)"
[ -n "$TZ" ] || TZ="CET-1CEST-2,M3.5.0/02:00:00,M10.5.0/03:00:00"
case "$TZ" in CET-1CEST,M3.5.0,M10.5.0/3) TZ="CET-1CEST-2,M3.5.0/02:00:00,M10.5.0/03:00:00";; esac
export TZ
exec /usr/sbin/ndhttpd.real "$@"
NDEOF
  chmod +x /usr/sbin/ndhttpd
  /etc/init.d/ndhttpd restart 2>/dev/null
fi

# The DumaOS apps are spawned by procmanager under procd, which clears the
# environment except for the "env" param, so the TZ export must also go
# into the dumaos init script (top-level for the fallback path, and into
# the procd env list; note procd keeps only the LAST env param, so TZ is
# appended to the existing NDPROC one).
if [ -z "$IPKG_INSTROOT" ] && ! grep -q 'procd_set_param env.*TZ=' /etc/init.d/dumaos 2>/dev/null; then
  sed -i '1a export TZ="$(uci -q get system.@system[0].timezone 2>/dev/null)"\n[ -n "$TZ" ] || TZ="CET-1CEST-2,M3.5.0/02:00:00,M10.5.0/03:00:00"\ncase "$TZ" in CET-1CEST,M3.5.0,M10.5.0/3) TZ="CET-1CEST-2,M3.5.0/02:00:00,M10.5.0/03:00:00";; esac\nexport TZ' /etc/init.d/dumaos
  sed -i 's#procd_set_param env NDPROC="/tmp/ndproc"#procd_set_param env NDPROC="/tmp/ndproc" TZ="$TZ"#' /etc/init.d/dumaos
  /etc/init.d/dumaos restart 2>/dev/null
fi

# The benchmark app never parses test results into the history index when
# options.save is true (that branch runs upload_test_data against the dead
# netduma cloud, which also deletes the history files), so the UI history
# stays empty and the detail page ("get_file_data") finds nothing because
# it only reads <time>.txt.gz. Two cron jobs cover both: one fills
# index.tests[].data from the raw 0-x/1-x/2-x result lines, the other
# gzips finished test files (the app gunzips/re-gzips them on read).
if [ -z "$IPKG_INSTROOT" ]; then
  chmod +x /usr/sbin/bench-gzip.sh /usr/sbin/bench-index.lua 2>/dev/null
  grep -q bench-index.lua /etc/crontabs/root 2>/dev/null || \
    sed -i '1i */2 * * * * lua /usr/sbin/bench-index.lua' /etc/crontabs/root 2>/dev/null
  grep -q bench-gzip.sh /etc/crontabs/root 2>/dev/null || \
    sed -i '1i */2 * * * * /bin/sh /usr/sbin/bench-gzip.sh' /etc/crontabs/root 2>/dev/null
fi

# DPI database ships in this package; restart the classifier so it loads the new nddpidb
if [ -z "$IPKG_INSTROOT" ]; then
  killall dpiclass 2>/dev/null
fi

if [ -z "$IPKG_INSTROOT" ] && command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
  nginx -s reload 2>/dev/null || /etc/init.d/nginx restart >/dev/null 2>&1
fi

/etc/init.d/ndhttpd enable
/etc/init.d/ndhttpd start
/etc/init.d/dumaos enable
/etc/init.d/dumaos start

exit 0
