#!/bin/sh

# Keep setup artifacts on upgrade, only clean on remove.
case "$1" in
    upgrade|configure) exit 0 ;;
esac

# The recovery helper lives outside the package file list because opkg runs
# postrm after deleting data files. Never discard the backup when restoration
# fails: it is the recovery path for the device.
if [ -z "$IPKG_INSTROOT" ] && [ -x /etc/dumaos-stock-backup/ubus-stack.sh ]; then
    if /etc/dumaos-stock-backup/ubus-stack.sh restore; then
        rm -f /etc/dumaos-stock-backup/ubus-stack.sh
        rmdir /etc/dumaos-stock-backup 2>/dev/null || true
    else
        echo "dumaos-repack: stock ubus restore failed; backup retained in /etc/dumaos-stock-backup" >&2
        exit 1
    fi
fi

# Artifacts created by setup.sh (kernel module + boot load list)
rm -f /etc/modules.d/99-dumaos-qos
rm -f /lib/modules/4.1.52/extra/act-connmark-damson-4.1.52.ko
depmod -a 4.1.52 2>/dev/null || true

# Firewall rule added by setup.sh
for s in $(uci -q show firewall 2>/dev/null | grep "=rule" | cut -d. -f2); do
    if [ "$(uci -q get firewall.$s.name)" = "dumaos_ui" ]; then
        uci -q delete firewall.$s
    fi
done
uci -q show firewall >/dev/null 2>&1 && uci -q commit firewall
/etc/init.d/firewall reload >/dev/null 2>&1 || true

# Drop the benchmark history cron jobs added by postinst.
if [ -z "$IPKG_INSTROOT" ] && [ -f /etc/crontabs/root ]; then
  sed -i '/bench-index.lua/d; /bench-gzip.sh/d' /etc/crontabs/root 2>/dev/null
fi

# Disable the DumaOS nginx reverse proxy on :80 (package file is purged,
# reload so nginx drops the include) and the seeded default theme.
if [ -z "$IPKG_INSTROOT" ]; then
  rm -f /etc/nginx/main_dumaos.conf
  [ -L /www/themes ] && rm -f /www/themes
  [ -L /www/nd-themes ] && rm -f /www/nd-themes
  command -v nginx >/dev/null 2>&1 && (nginx -t >/dev/null 2>&1 && nginx -s reload 2>/dev/null)
fi

# UCI configs left behind by uci commit
uci -q delete dumaos
uci -q delete ndhttpd
uci -q delete ndproxy

exit 0
