#!/bin/sh
# Busybox tar lacks GNU tar's -m (don't restore mtimes), which netduma's
# cloud-sync (adblocker updates) uses, e.g. -xmzf or "-m -xzf".
# Strip the m from short-option clusters and pass everything else through.
# A bare "-" (tar cf - | tar xf -) is a real operand and must survive;
# only drop a "-" that is what a lone -m degraded into.
args=""
for arg in "$@"; do
    orig=$arg
    case "$arg" in
        --*) ;;
        -*)
            case "$arg" in
                *m*) arg=$(printf '%s' "$arg" | tr -d 'm') ;;
            esac
            ;;
    esac
    if [ "$arg" = "-" ] && [ "$orig" != "-" ]; then
        continue
    fi
    args="${args}${args:+
}${arg}"
done
old_ifs=$IFS
IFS='
'
set -f
# shellcheck disable=SC2086 # split only on the newline delimiter above
set -- $args
IFS=$old_ifs
set +f
exec /bin/busybox tar "$@"
